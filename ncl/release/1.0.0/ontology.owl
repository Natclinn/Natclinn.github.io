    <!-- https://w3id.org/NCL/ontology/hasProcessedIngredients -->


    <owl:ObjectProperty rdf:about="https://w3id.org/NCL/ontology/hasProcessedIngredients">
        <rdfs:domain rdf:resource="https://w3id.org/NCL/ontology/CalculatedNOVAgroupDetails"/>
        <rdfs:range rdf:resource="https://w3id.org/NCL/ontology/Ingredient"/>
        <rdfs:comment xml:lang="fr">Liste les ingrédients transformés trouvés lors du calcul NOVA.</rdfs:comment>
        <rdfs:comment xml:lang="en">Lists processed ingredients found during NOVA calculation.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/NCL/ontology/hasProductArgument -->


    <owl:ObjectProperty rdf:about="https://w3id.org/NCL/ontology/hasProductArgument">
        <rdfs:domain rdf:resource="https://w3id.org/NCL/ontology/Product"/>
        <rdfs:range rdf:resource="https://w3id.org/NCL/ontology/ProductArgument"/>
        <rdfs:comment xml:lang="en">Link a food industry product to an argument.</rdfs:comment>
        <rdfs:comment xml:lang="fr">Relie un produit de l&apos;industrie agro-alimentaire à un argument.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/NCL/ontology/hasQuantifiedElement -->


    <owl:ObjectProperty rdf:about="https://w3id.org/NCL/ontology/hasQuantifiedElement">
        <rdfs:domain rdf:resource="https://w3id.org/NCL/ontology/Resource"/>
        <rdfs:range rdf:resource="https://w3id.org/NCL/ontology/QuantifiedElement"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/NCL/ontology/hasRawIngredients -->


    <owl:ObjectProperty rdf:about="https://w3id.org/NCL/ontology/hasRawIngredients">
        <rdfs:domain rdf:resource="https://w3id.org/NCL/ontology/CalculatedNOVAgroupDetails"/>
        <rdfs:range rdf:resource="https://w3id.org/NCL/ontology/Ingredient"/>
        <rdfs:comment xml:lang="fr">Liste les ingrédients bruts trouvés lors du calcul NOVA.</rdfs:comment>
        <rdfs:comment xml:lang="en">Lists raw ingredients found during NOVA calculation.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/NCL/ontology/hasReferenceProductArgument -->


    <owl:ObjectProperty rdf:about="https://w3id.org/NCL/ontology/hasReferenceProductArgument">
        <rdfs:domain rdf:resource="https://w3id.org/NCL/ontology/LinkToArgument"/>
        <rdfs:range rdf:resource="https://w3id.org/NCL/ontology/ProductArgument"/>
        <rdfs:comment xml:lang="en">Links a LinkToArgument to the referenced ProductArgument.</rdfs:comment>
        <rdfs:comment xml:lang="fr">Relie un LinkToArgument au ProductArgument référencé.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/NCL/ontology/hasRole -->


    <owl:ObjectProperty rdf:about="https://w3id.org/NCL/ontology/hasRole">
        <rdfs:domain rdf:resource="https://w3id.org/NCL/ontology/Ingredient"/>
        <rdfs:range rdf:resource="https://w3id.org/NCL/ontology/Tag"/>
        <rdfs:comment xml:lang="en">Links an ingredient to a Tag resource representing its technological or sensory function (preservative, flavor enhancer, etc.).</rdfs:comment>
        <rdfs:comment xml:lang="fr">Relie un ingrédient à une ressource Tag représentant sa fonction technologique ou sensorielle (conservateur, exhausteur de goût, etc.).</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/NCL/ontology/hasShape -->


    <owl:ObjectProperty rdf:about="https://w3id.org/NCL/ontology/hasShape">
        <rdfs:domain rdf:resource="https://w3id.org/NCL/ontology/Packaging"/>
        <rdfs:range rdf:resource="https://w3id.org/NCL/ontology/Shape"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/NCL/ontology/hasSource -->


    <owl:ObjectProperty rdf:about="https://w3id.org/NCL/ontology/hasSource">
        <rdfs:domain rdf:resource="https://w3id.org/NCL/ontology/ProductArgument"/>
        <rdfs:range rdf:resource="https://w3id.org/NCL/ontology/Source"/>
        <rdfs:comment xml:lang="en">Link an argument to its source (consumer survey, scientific journal, etc.).</rdfs:comment>
        <rdfs:comment xml:lang="fr">Relie un argument à sa source (enquête consommateur, revue scientifique, etc.).</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/NCL/ontology/hasStakeholder -->


    <owl:ObjectProperty rdf:about="https://w3id.org/NCL/ontology/hasStakeholder">
        <rdfs:domain rdf:resource="https://w3id.org/NCL/ontology/ProductArgument"/>
        <rdfs:range rdf:resource="https://w3id.org/NCL/ontology/Stakeholder"/>
        <rdfs:comment xml:lang="en">Link an argument to its stakeholder (consumer, manufacturer, etc.).</rdfs:comment>
        <rdfs:comment xml:lang="fr">Relie un argument à sa partie prenante (consommateur, fabricant, etc.).</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/NCL/ontology/hasSubcategory -->


    <owl:ObjectProperty rdf:about="https://w3id.org/NCL/ontology/hasSubcategory">
        <rdfs:domain rdf:resource="https://w3id.org/NCL/ontology/ProductArgument"/>
        <rdfs:range rdf:resource="https://w3id.org/NCL/ontology/Subcategory"/>
        <rdfs:comment xml:lang="en">Links an argument to its subcategory.</rdfs:comment>
        <rdfs:comment xml:lang="fr">Relie un argument à sa sous-catégorie.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/NCL/ontology/hasTag -->


    <owl:ObjectProperty rdf:about="https://w3id.org/NCL/ontology/hasTag">
        <rdfs:domain rdf:resource="https://w3id.org/NCL/ontology/Product"/>
        <rdfs:range rdf:resource="https://w3id.org/NCL/ontology/Tag"/>
        <rdfs:comment xml:lang="en">Links a product to a tag.</rdfs:comment>
        <rdfs:comment xml:lang="fr">Relie un produit à un tag.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/NCL/ontology/hasTagArgumentBindingInitiator -->


    <owl:ObjectProperty rdf:about="https://w3id.org/NCL/ontology/hasTagArgumentBindingInitiator">
        <rdfs:domain rdf:resource="https://w3id.org/NCL/ontology/LinkToArgument"/>
        <rdfs:range rdf:resource="https://w3id.org/NCL/ontology/TagArgumentBinding"/>
        <rdfs:comment xml:lang="fr">Le tag de liaison d&apos;argument identifiant qui a initié le lien vers l&apos;argument.</rdfs:comment>
        <rdfs:comment xml:lang="en">The tag argument binding identifying who initiated the link to the argument.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/NCL/ontology/hasTagCheck -->


    <owl:ObjectProperty rdf:about="https://w3id.org/NCL/ontology/hasTagCheck">
        <rdfs:domain rdf:resource="https://w3id.org/NCL/ontology/Product"/>
        <rdfs:range rdf:resource="https://w3id.org/NCL/ontology/Tag"/>
        <rdfs:comment xml:lang="en">Links a product to a validation tag.</rdfs:comment>
        <rdfs:comment xml:lang="fr">Relie un produit à un tag de vérification.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/NCL/ontology/hasTagInitiator -->


    <owl:ObjectProperty rdf:about="https://w3id.org/NCL/ontology/hasTagInitiator">
        <rdfs:domain rdf:resource="https://w3id.org/NCL/ontology/LinkToArgument"/>
        <rdfs:range rdf:resource="https://w3id.org/NCL/ontology/Tag"/>
        <rdfs:comment xml:lang="fr">Tag identifiant qui a initié le lien vers l&apos;argument.</rdfs:comment>
        <rdfs:comment xml:lang="en">Tag identifying who initiated the link to the argument.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/NCL/ontology/hasTechnologicalIngredients -->


    <owl:ObjectProperty rdf:about="https://w3id.org/NCL/ontology/hasTechnologicalIngredients">
        <rdfs:domain rdf:resource="https://w3id.org/NCL/ontology/CalculatedNOVAgroupDetails"/>
        <rdfs:range rdf:resource="https://w3id.org/NCL/ontology/Ingredient"/>
        <rdfs:comment xml:lang="fr">Liste les ingrédients technologiques trouvés lors du calcul NOVA.</rdfs:comment>
        <rdfs:comment xml:lang="en">Lists technological ingredients found during NOVA calculation.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/NCL/ontology/hasTypeSource -->


    <owl:ObjectProperty rdf:about="https://w3id.org/NCL/ontology/hasTypeSource">
        <rdfs:domain rdf:resource="https://w3id.org/NCL/ontology/Source"/>
        <rdfs:range rdf:resource="https://w3id.org/NCL/ontology/TypeSource"/>
        <rdfs:comment xml:lang="en">Link a source to its type (expert, peer-reviewed article, etc.).</rdfs:comment>
        <rdfs:comment xml:lang="fr">Relie une source à son type (expert, article peer-reviewed, etc.).</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/NCL/ontology/hasVerbatim -->


    <owl:ObjectProperty rdf:about="https://w3id.org/NCL/ontology/hasVerbatim">
        <rdfs:domain rdf:resource="https://w3id.org/NCL/ontology/ProductArgument"/>
        <rdfs:range rdf:resource="https://w3id.org/NCL/ontology/Verbatim"/>
        <rdfs:comment xml:lang="en">Link an argument to its verbatim.</rdfs:comment>
        <rdfs:comment xml:lang="fr">Link an argument to its verbatim.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/NCL/ontology/identifier -->


    <owl:ObjectProperty rdf:about="https://w3id.org/NCL/ontology/identifier">
        <rdfs:domain rdf:resource="https://w3id.org/NCL/ontology/Resource"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/NCL/ontology/refersTo -->


    <owl:ObjectProperty rdf:about="https://w3id.org/NCL/ontology/refersTo">
        <rdfs:domain rdf:resource="https://w3id.org/NCL/ontology/QuantifiedElement"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/NCL/ontology/Ingredient"/>
                    <rdf:Description rdf:about="https://w3id.org/NCL/ontology/Product"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment xml:lang="en">Relates a product or ingredient to its quantification in a food industry product.</rdfs:comment>
        <rdfs:comment xml:lang="fr">Relie un produit ou un ingrédient à sa quantification dans un produit de l&apos;industrie agro-alimentaire.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/NCL/ontology/target -->


    <owl:ObjectProperty rdf:about="https://w3id.org/NCL/ontology/target">
        <rdfs:domain rdf:resource="https://w3id.org/NCL/ontology/ProductArgument"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/NCL/ontology/Allegation"/>
                    <rdf:Description rdf:about="https://w3id.org/NCL/ontology/CleanLabel"/>
                    <rdf:Description rdf:about="https://w3id.org/NCL/ontology/ControlledOriginLabel"/>
                    <rdf:Description rdf:about="https://w3id.org/NCL/ontology/Ingredient"/>
                    <rdf:Description rdf:about="https://w3id.org/NCL/ontology/ManufacturingProcess"/>
                    <rdf:Description rdf:about="https://w3id.org/NCL/ontology/NutriScore"/>
                    <rdf:Description rdf:about="https://w3id.org/NCL/ontology/Origin"/>
                    <rdf:Description rdf:about="https://w3id.org/NCL/ontology/Packaging"/>
                    <rdf:Description rdf:about="https://w3id.org/NCL/ontology/Product"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment xml:lang="en">Link an argument to a component (product, ingredient, packaging, nutri-score, etc.) of a food industry product.</rdfs:comment>
        <rdfs:comment xml:lang="fr">Relie un argument à un composant (produit, ingrédient, packaging, nutri-score,etc.) d&apos;un produit de l&apos;industrie agro-alimentaire.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- https://w3id.org/NCL/ontology/aim -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/NCL/ontology/aim">
        <rdfs:domain rdf:resource="https://w3id.org/NCL/ontology/TagArgumentBinding"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Aim or objective related to the tag binding.</rdfs:comment>
        <rdfs:comment xml:lang="fr">Objectif ou visée du binding de tag.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/NCL/ontology/assertion -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/NCL/ontology/assertion">
        <rdfs:domain rdf:resource="https://w3id.org/NCL/ontology/TagArgumentBinding"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="fr">L&apos;assertion portée par le binding de tag.</rdfs:comment>
        <rdfs:comment xml:lang="en">The assertion carried by the tag binding.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/NCL/ontology/bindingKeywords -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/NCL/ontology/bindingKeywords">
        <rdfs:domain rdf:resource="https://w3id.org/NCL/ontology/TagArgumentBinding"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Keywords used to bind a tag to argumentation context.</rdfs:comment>
        <rdfs:comment xml:lang="fr">Mots-clés utilisés pour lier un tag au contexte d&apos;argumentation.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/NCL/ontology/condition -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/NCL/ontology/condition">
        <rdfs:domain rdf:resource="https://w3id.org/NCL/ontology/ProductArgument"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="fr">Condition dans laquelle l&apos;argument s&apos;applique.</rdfs:comment>
        <rdfs:comment xml:lang="en">Condition under which the argument applies.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/NCL/ontology/containsAdditives -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/NCL/ontology/containsAdditives">
        <rdfs:domain rdf:resource="https://w3id.org/NCL/ontology/Product"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">Indicates whether the product contains additives.</rdfs:comment>
        <rdfs:comment xml:lang="fr">Indique si le produit contient des additifs.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/NCL/ontology/containsIngredientWithFunction -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/NCL/ontology/containsIngredientWithFunction">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/NCL/ontology/fiability -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/NCL/ontology/fiability">
        <rdfs:domain rdf:resource="https://w3id.org/NCL/ontology/TypeSource"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
        <rdfs:comment xml:lang="en">Fiability score of the source type.</rdfs:comment>
        <rdfs:comment xml:lang="fr">Score de fiabilité du type de source.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/NCL/ontology/groupe1 -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/NCL/ontology/groupe1">
        <rdfs:domain rdf:resource="https://w3id.org/NCL/ontology/NOVAgroupDetails"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="fr">Caractéristiques du groupe NOVA 1 (aliments non transformés ou minimalement transformés).</rdfs:comment>
        <rdfs:comment xml:lang="en">NOVA group 1 characteristics (unprocessed or minimally processed foods).</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/NCL/ontology/groupe2 -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/NCL/ontology/groupe2">
        <rdfs:domain rdf:resource="https://w3id.org/NCL/ontology/NOVAgroupDetails"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="fr">Caractéristiques du groupe NOVA 2 (ingrédients culinaires transformés).</rdfs:comment>
        <rdfs:comment xml:lang="en">NOVA group 2 characteristics (processed culinary ingredients).</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/NCL/ontology/groupe3 -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/NCL/ontology/groupe3">
        <rdfs:domain rdf:resource="https://w3id.org/NCL/ontology/NOVAgroupDetails"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="fr">Caractéristiques du groupe NOVA 3 (aliments transformés).</rdfs:comment>
        <rdfs:comment xml:lang="en">NOVA group 3 characteristics (processed foods).</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/NCL/ontology/groupe4 -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/NCL/ontology/groupe4">
        <rdfs:domain rdf:resource="https://w3id.org/NCL/ontology/NOVAgroupDetails"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="fr">Caractéristiques du groupe NOVA 4 (produits ultra-transformés).</rdfs:comment>
        <rdfs:comment xml:lang="en">NOVA group 4 characteristics (ultra-processed foods and drinks).</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/NCL/ontology/hasCalculatedNOVAgroup -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/NCL/ontology/hasCalculatedNOVAgroup">
        <rdfs:domain rdf:resource="https://w3id.org/NCL/ontology/Product"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#nonNegativeInteger"/>
        <rdfs:comment xml:lang="en">Calculated NOVA group (1..4) inferred by rules, not the OFF-provided value.</rdfs:comment>
        <rdfs:comment xml:lang="fr">Groupe NOVA calculé (1..4) inféré par les règles, distinct de la valeur fournie par OFF.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/NCL/ontology/hasCiqualFoodCode -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/NCL/ontology/hasCiqualFoodCode">
        <rdfs:domain rdf:resource="https://w3id.org/NCL/ontology/Ingredient"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Ciqual code for a food industry product.</rdfs:comment>
        <rdfs:comment xml:lang="fr">Code Ciqual d&apos;un produit de l&apos;industrie agroalimentaire.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/NCL/ontology/hasCiqualProxyFoodCode -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/NCL/ontology/hasCiqualProxyFoodCode">
        <rdfs:domain rdf:resource="https://w3id.org/NCL/ontology/Ingredient"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Ciqual code for a similar food industry product.</rdfs:comment>
        <rdfs:comment xml:lang="fr">Code Ciqual d&apos;un produit similaire de l&apos;industrie agroalimentaire.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/NCL/ontology/hasNOVAgroup -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/NCL/ontology/hasNOVAgroup">
        <rdfs:domain rdf:resource="https://w3id.org/NCL/ontology/Product"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#nonNegativeInteger"/>
        <rdfs:comment xml:lang="fr">Groupe NOVA (1..4) tel que fourni par Open Food Facts.</rdfs:comment>
        <rdfs:comment xml:lang="en">NOVA group (1..4) as provided by Open Food Facts.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/NCL/ontology/hasText -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/NCL/ontology/hasText">
