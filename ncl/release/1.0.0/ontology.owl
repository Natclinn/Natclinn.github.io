<?xml version="1.0"?>
<rdf:RDF xmlns="https://w3id.org/NCL/ontology/NatclinnTbox#"
     xml:base="https://w3id.org/NCL/ontology/NatclinnTbox"
     xmlns:dc="http://purl.org/dc/elements/1.1/"
     xmlns:org="http://www.w3.org/ns/org#"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
