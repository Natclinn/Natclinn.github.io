    <!-- https://w3id.org/NCL/ontology/aboutTag -->


    <owl:ObjectProperty rdf:about="https://w3id.org/NCL/ontology/aboutTag">
        <rdfs:domain rdf:resource="https://w3id.org/NCL/ontology/TagArgumentBinding"/>
        <rdfs:range rdf:resource="https://w3id.org/NCL/ontology/Tag"/>
        <rdfs:comment xml:lang="en">Links a TagArgumentBinding to the related Tag.</rdfs:comment>
        <rdfs:comment xml:lang="fr">Relie un TagArgumentBinding au Tag concerné.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/NCL/ontology/containsIngredientWithFunction -->


    <owl:ObjectProperty rdf:about="https://w3id.org/NCL/ontology/containsIngredientWithFunction">
        <rdfs:domain rdf:resource="https://w3id.org/NCL/ontology/Product"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/NCL/ontology/hasAdditiveIngredients -->


    <owl:ObjectProperty rdf:about="https://w3id.org/NCL/ontology/hasAdditiveIngredients">
        <rdfs:domain rdf:resource="https://w3id.org/NCL/ontology/CalculatedNOVAgroupDetails"/>
        <rdfs:range rdf:resource="https://w3id.org/NCL/ontology/Ingredient"/>
        <rdfs:comment xml:lang="fr">Liste les ingrédients additifs trouvés lors du calcul NOVA.</rdfs:comment>
        <rdfs:comment xml:lang="en">Lists additive ingredients found during NOVA calculation.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/NCL/ontology/hasAllegation -->


    <owl:ObjectProperty rdf:about="https://w3id.org/NCL/ontology/hasAllegation">
        <rdfs:domain rdf:resource="https://w3id.org/NCL/ontology/Product"/>
        <rdfs:range rdf:resource="https://w3id.org/NCL/ontology/Allegation"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/NCL/ontology/hasAttribute -->


    <owl:ObjectProperty rdf:about="https://w3id.org/NCL/ontology/hasAttribute">
        <rdfs:domain rdf:resource="https://w3id.org/NCL/ontology/ProductArgument"/>
        <rdfs:range rdf:resource="https://w3id.org/NCL/ontology/Attribute"/>
        <rdfs:comment xml:lang="fr">Attribut de la naturalité d&apos;un produit de l&apos;industrie agro-alimentaire.</rdfs:comment>
        <rdfs:comment xml:lang="en">The naturalness attribute of a food industry product.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/NCL/ontology/hasCalculatedNOVAgroupDetails -->


    <owl:ObjectProperty rdf:about="https://w3id.org/NCL/ontology/hasCalculatedNOVAgroupDetails">
        <rdfs:domain rdf:resource="https://w3id.org/NCL/ontology/Product"/>
        <rdfs:range rdf:resource="https://w3id.org/NCL/ontology/CalculatedNOVAgroupDetails"/>
        <rdfs:comment xml:lang="en">Links a product to its calculated NOVA group details.</rdfs:comment>
        <rdfs:comment xml:lang="fr">Relie un produit aux détails de son groupe NOVA calculé.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/NCL/ontology/hasCategory -->


    <owl:ObjectProperty rdf:about="https://w3id.org/NCL/ontology/hasCategory">
        <rdfs:domain rdf:resource="https://w3id.org/NCL/ontology/ProductArgument"/>
        <rdfs:range rdf:resource="https://w3id.org/NCL/ontology/Category"/>
        <rdfs:comment xml:lang="en">Links an argument to its main category.</rdfs:comment>
        <rdfs:comment xml:lang="fr">Relie un argument à sa catégorie principale.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/NCL/ontology/hasCleanLabel -->


    <owl:ObjectProperty rdf:about="https://w3id.org/NCL/ontology/hasCleanLabel">
        <rdfs:domain rdf:resource="https://w3id.org/NCL/ontology/Product"/>
        <rdfs:range rdf:resource="https://w3id.org/NCL/ontology/CleanLabel"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/NCL/ontology/hasComposedOf -->


    <owl:ObjectProperty rdf:about="https://w3id.org/NCL/ontology/hasComposedOf">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/NCL/ontology/CompositeIngredient"/>
                    <rdf:Description rdf:about="https://w3id.org/NCL/ontology/CompositeProduct"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/NCL/ontology/Ingredient"/>
                    <rdf:Description rdf:about="https://w3id.org/NCL/ontology/Product"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
    </owl:ObjectProperty>
    


