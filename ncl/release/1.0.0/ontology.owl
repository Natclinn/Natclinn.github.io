        <rdfs:domain rdf:resource="https://w3id.org/NCL/ontology/QuantifiedElement"/>
        <rdfs:comment xml:lang="en">Quantity of a by-product or ingredient present in a food industry product.</rdfs:comment>
        <rdfs:comment xml:lang="fr">Quantité présente d&apos;un sous-produit ou d&apos;un ingrédient dans un produit de l&apos;industrie agro-alimentaire.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/NCL/ontology/rank -->


