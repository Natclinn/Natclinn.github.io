    <owl:ObjectProperty rdf:about="https://w3id.org/NCL/ontology/hasContext">
        <rdfs:domain rdf:resource="https://w3id.org/NCL/ontology/ProductArgument"/>
        <rdfs:range rdf:resource="https://w3id.org/NCL/ontology/Context"/>
        <rdfs:comment xml:lang="en">Links an argument to its context</rdfs:comment>
        <rdfs:comment xml:lang="fr">Relie un argument à son contexte</rdfs:comment>
    </owl:ObjectProperty>
    


