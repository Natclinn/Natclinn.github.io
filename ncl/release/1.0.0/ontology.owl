        <rdfs:comment xml:lang="fr">Le contexte ingrédient d&apos;un argument.</rdfs:comment>
        <rdfs:comment xml:lang="en">The ingredient context of an argument.</rdfs:comment>
    </owl:ObjectProperty>
    


