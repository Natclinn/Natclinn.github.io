###  https://natclinn.github.io/aboutTag
<https://natclinn.github.io/aboutTag> rdf:type owl:ObjectProperty ;
                                      rdfs:domain <https://natclinn.github.io/TagArgumentBinding> ;
                                      rdfs:range <https://natclinn.github.io/Tag> ;
                                      rdfs:comment "Links a TagArgumentBinding to the related Tag."@en ,
                                                   "Relie un TagArgumentBinding au Tag concerné."@fr ;
                                      rdfs:label "About tag"@en ,
                                                 "Concerne le tag"@fr ;
                                      <http://www.w3.org/2004/02/skos/core#prefLabel> "About tag"@en ,
                                                                                      "Concerne le tag"@fr .


