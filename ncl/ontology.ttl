###  https://natclinn.github.io/isComposedOf
<https://natclinn.github.io/isComposedOf> rdf:type owl:ObjectProperty ;
                                          rdfs:domain [ rdf:type owl:Class ;
                                                        owl:unionOf ( <https://natclinn.github.io/CompositeIngredient>
                                                                      <https://natclinn.github.io/CompositeProduct>
                                                                    )
                                                      ] ;
                                          rdfs:range [ rdf:type owl:Class ;
                                                       owl:unionOf ( <https://natclinn.github.io/Ingredient>
                                                                     <https://natclinn.github.io/Product>
                                                                   )
                                                     ] ;
                                          rdfs:comment "Relates a composite resource to the resources it is composed of."@en ,
                                                       "Relie une ressource composite aux ressources qui la composent."@fr ;
                                          rdfs:label "Est composé de"@fr ,
                                                     "Is composed of"@en ;
                                          <http://www.w3.org/2004/02/skos/core#prefLabel> "Est composé de"@fr ,
                                                                                          "Is composed of"@en .


###  https://natclinn.github.io/refersTo
<https://natclinn.github.io/refersTo> rdf:type owl:ObjectProperty ;
                                      rdfs:domain <https://natclinn.github.io/QuantifiedElement> ;
                                      rdfs:range [ rdf:type owl:Class ;
                                                   owl:unionOf ( <https://natclinn.github.io/Ingredient>
                                                                 <https://natclinn.github.io/Product>
                                                               )
                                                 ] ;
                                      rdfs:comment "Relates a product or ingredient to its quantification in a food industry product."@en ,
                                                   "Relie un produit ou un ingrédient à sa quantification dans un produit de l'industrie agro-alimentaire."@fr ;
                                      rdfs:label "Refers to"@en ,
                                                 "Réfère à"@fr ;
                                      <http://www.w3.org/2004/02/skos/core#prefLabel> "Refers to"@en ,
                                                                                      "Réfère à"@fr .


###  https://natclinn.github.io/target
<https://natclinn.github.io/target> rdf:type owl:ObjectProperty ;
                                    rdfs:domain <https://natclinn.github.io/ProductArgument> ;
                                    rdfs:range [ rdf:type owl:Class ;
                                                 owl:unionOf ( <https://natclinn.github.io/Allegation>
                                                               <https://natclinn.github.io/CleanLabel>
                                                               <https://natclinn.github.io/ControlledOriginLabel>
                                                               <https://natclinn.github.io/Ingredient>
                                                               <https://natclinn.github.io/ManufacturingProcess>
                                                               <https://natclinn.github.io/NutriScore>
                                                               <https://natclinn.github.io/Origin>
                                                               <https://natclinn.github.io/Packaging>
                                                               <https://natclinn.github.io/Product>
                                                             )
                                               ] ;
                                    rdfs:comment "Link an argument to a component (product, ingredient, packaging, nutri-score, etc.) of a food industry product."@en ,
                                                 "Relie un argument à un composant (produit, ingrédient, packaging, nutri-score,etc.) d'un produit de l'industrie agro-alimentaire."@fr ;
                                    rdfs:label "Cible"@fr ,
                                               "Target"@en ;
                                    <http://www.w3.org/2004/02/skos/core#prefLabel> "Cible"@fr ,
                                                                                    "Target"@en .


