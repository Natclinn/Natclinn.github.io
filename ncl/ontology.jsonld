  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Link an argument to a component (product, ingredient, packaging, nutri-score, etc.) of a food industry product."
  }, {
    "@language" : "fr",
    "@value" : "Relie un argument à un composant (produit, ingrédient, packaging, nutri-score,etc.) d'un produit de l'industrie agro-alimentaire."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
