}, {
  "@id" : "https://natclinn.github.io/NatclinnTbox",
  "@type" : [ "http://www.w3.org/2002/07/owl#Ontology" ],
  "http://purl.org/dc/elements/1.1/creator" : [ {
    "@value" : "Raphael CONDE SALAZAR, Pierre BISQUERT, Rallou THOMOPOULOS, Magalie Weber"
  } ],
  "http://purl.org/dc/elements/1.1/description" : [ {
    "@language" : "en",
    "@value" : "Tbox for the Natcl'inn ontology"
  }, {
    "@language" : "fr",
    "@value" : "Tbox pour l'ontologie Natcl'inn"
  } ],
  "http://purl.org/dc/elements/1.1/title" : [ {
    "@language" : "en",
    "@value" : "NCL"
  } ],
  "http://purl.org/dc/terms/abstract" : [ {
    "@language" : "fr",
    "@value" : "Le projet NATCLâ€™INN vise Ã  aider les entreprises agroalimentaires Ã  mieux rÃ©pondre aux attentes de naturalitÃ© des consommateurs, perÃ§ue comme gage de qualitÃ©, de santÃ© et de goÃ»t. En sâ€™appuyant sur la caractÃ©risation des reprÃ©sentations de la naturalitÃ© et lâ€™identification de marqueurs pertinents, il dÃ©veloppe un outil dâ€™arbitrage multicritÃ¨re intÃ©grant contraintes techniques, Ã©conomiques et rÃ©glementaires. PortÃ© par lâ€™ADRIA, lâ€™UBO-LEGO, lâ€™INRAE et plusieurs partenaires industriels, ce projet collaboratif est labellisÃ© par Valorial."
  }, {
    "@language" : "en",
    "@value" : "The NATCLâ€™INN project aims to help agri-food companies better meet consumers' expectations for naturalness, which is perceived as a guarantee of quality, health and taste. Based on the characterisation of representations of naturalness and the identification of relevant markers, it is developing a multi-criteria arbitration tool that integrates technical, economic and regulatory constraints. Led by ADRIA, UBO-LEGO, INRAE and several industrial partners, this collaborative project has been certified by Valorial."
  } ],
  "http://purl.org/dc/terms/created" : [ {
    "@language" : "fr",
    "@value" : "Le 5 Octobre 2021"
  }, {
    "@language" : "en",
    "@value" : "October 5th, 2021"
  } ],
