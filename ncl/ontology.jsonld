}, {
  "@id" : "https://natclinn.github.io/NatclinnTbox",
  "@type" : [ "http://www.w3.org/2002/07/owl#Ontology" ],
  "http://purl.org/dc/elements/1.1/creator" : [ {
    "@language" : "en",
    "@value" : "Raphael CONDE SALAZAR, Pierre BISQUERT, Rallou THOMOPOULOS, Magalie Weber"
  }, {
    "@language" : "fr",
    "@value" : "Raphaël CONDE SALAZAR, Pierre BISQUERT, Rallou THOMOPOULOS, Magalie Weber"
  } ],
  "http://purl.org/dc/elements/1.1/description" : [ {
    "@language" : "en",
    "@value" : "Tbox for the Natcl'inn ontology"
  }, {
    "@language" : "fr",
    "@value" : "Tbox pour l'ontologie Natcl'inn"
  } ],
  "http://purl.org/dc/elements/1.1/title" : [ {
    "@language" : "en",
    "@value" : "NCL"
  } ],
  "http://purl.org/dc/terms/abstract" : [ {
    "@language" : "fr",
    "@value" : "Le projet NATCL’INN vise à aider les entreprises agroalimentaires à mieux répondre aux attentes de naturalité des consommateurs, perçue comme gage de qualité, de santé et de goût. En s’appuyant sur la caractérisation des représentations de la naturalité et l’identification de marqueurs pertinents, il développe un outil d’arbitrage multicritère intégrant contraintes techniques, économiques et réglementaires. Porté par l’ADRIA, l’UBO-LEGO, l’INRAE et plusieurs partenaires industriels, ce projet collaboratif est labellisé par Valorial."
  }, {
    "@language" : "en",
    "@value" : "The NATCL’INN project aims to help agri-food companies better meet consumers' expectations for naturalness, which is perceived as a guarantee of quality, health and taste. Based on the characterisation of representations of naturalness and the identification of relevant markers, it is developing a multi-criteria arbitration tool that integrates technical, economic and regulatory constraints. Led by ADRIA, UBO-LEGO, INRAE and several industrial partners, this collaborative project has been certified by Valorial."
  } ],
  "http://purl.org/dc/terms/created" : [ {
    "@language" : "fr",
    "@value" : "Le 5 Octobre 2021"
  }, {
    "@language" : "en",
    "@value" : "October 5th, 2021"
  } ],
  "http://purl.org/dc/terms/license" : [ {
    "@id" : "http://creativecommons.org/licenses/by/4.0/"
  } ],
  "http://purl.org/ontology/bibo/doi" : [ {
