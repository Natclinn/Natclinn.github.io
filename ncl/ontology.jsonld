    "@value" : "Classement d'un ingrédient ou d'un sous-produit dans l’énoncé textuel de la composition d'un produit."
  }, {
    "@language" : "en",
    "@value" : "Classification of an ingredient or by-product in the textual statement of a product's composition."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/NCL/ontology/QuantifiedElement"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#nonNegativeInteger"
  } ]
}, {
  "@id" : "https://w3id.org/NCL/ontology/refersTo",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Relates a product or ingredient to its quantification in a food industry product."
  }, {
    "@language" : "fr",
    "@value" : "Relie un produit ou un ingrédient à sa quantification dans un produit de l'industrie agro-alimentaire."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/NCL/ontology/QuantifiedElement"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "_:genid13"
  } ]
}, {
  "@id" : "https://w3id.org/NCL/ontology/supValue",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Upper bound value for the argument condition."
  }, {
    "@language" : "fr",
    "@value" : "Valeur maximale pour la condition de l'argument."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
