  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "fr",
    "@value" : "Type de l'argument (positif ou négatif) vis à vis de sa cible."
  }, {
    "@language" : "en",
    "@value" : "Type of argument (positive or negative) in relation to its target."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/NCL/ontology/ProductArgument"
  } ],
