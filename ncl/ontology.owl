    <!-- https://natclinn.github.io/aboutTag -->


    <owl:ObjectProperty rdf:about="https://natclinn.github.io/aboutTag">
        <rdfs:domain rdf:resource="https://natclinn.github.io/TagArgumentBinding"/>
        <rdfs:range rdf:resource="https://natclinn.github.io/Tag"/>
        <rdfs:comment xml:lang="en">Links a TagArgumentBinding to the related Tag.</rdfs:comment>
        <rdfs:comment xml:lang="fr">Relie un TagArgumentBinding au Tag concerné.</rdfs:comment>
        <rdfs:label xml:lang="en">About tag</rdfs:label>
        <rdfs:label xml:lang="fr">Concerne le tag</rdfs:label>
        <skos:prefLabel xml:lang="en">About tag</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">Concerne le tag</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://natclinn.github.io/containsIngredientWithFunction -->


    <owl:ObjectProperty rdf:about="https://natclinn.github.io/containsIngredientWithFunction">
        <rdfs:domain rdf:resource="https://natclinn.github.io/Product"/>
    </owl:ObjectProperty>
    


    <!-- https://natclinn.github.io/hasAdditiveIngredients -->


    <owl:ObjectProperty rdf:about="https://natclinn.github.io/hasAdditiveIngredients">
        <rdfs:domain rdf:resource="https://natclinn.github.io/CalculatedNOVAgroupDetails"/>
        <rdfs:range rdf:resource="https://natclinn.github.io/Ingredient"/>
        <rdfs:comment xml:lang="fr">Liste les ingrédients additifs trouvés lors du calcul NOVA.</rdfs:comment>
        <rdfs:comment xml:lang="en">Lists additive ingredients found during NOVA calculation.</rdfs:comment>
        <rdfs:label xml:lang="fr">A pour ingrédients additifs</rdfs:label>
        <rdfs:label xml:lang="en">Has additive ingredients</rdfs:label>
        <skos:prefLabel xml:lang="fr">A pour ingrédients additifs</skos:prefLabel>
        <skos:prefLabel xml:lang="en">Has additive ingredients</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://natclinn.github.io/hasAllegation -->


    <owl:ObjectProperty rdf:about="https://natclinn.github.io/hasAllegation">
        <rdfs:domain rdf:resource="https://natclinn.github.io/Product"/>
        <rdfs:range rdf:resource="https://natclinn.github.io/Allegation"/>
        <rdfs:comment xml:lang="en">Links a product to its allegations or claims.</rdfs:comment>
        <rdfs:comment xml:lang="fr">Relie un produit à ses allégations.</rdfs:comment>
        <rdfs:label xml:lang="fr">A pour allégation</rdfs:label>
        <rdfs:label xml:lang="en">Has allegation</rdfs:label>
        <skos:prefLabel xml:lang="fr">A pour allégation</skos:prefLabel>
        <skos:prefLabel xml:lang="en">Has allegation</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://natclinn.github.io/hasAttribute -->


    <owl:ObjectProperty rdf:about="https://natclinn.github.io/hasAttribute">
        <rdfs:domain rdf:resource="https://natclinn.github.io/ProductArgument"/>
        <rdfs:range rdf:resource="https://natclinn.github.io/Attribute"/>
        <rdfs:comment xml:lang="fr">Attribut de la naturalité d&apos;un produit de l&apos;industrie agro-alimentaire.</rdfs:comment>
        <rdfs:comment xml:lang="en">The naturalness attribute of a food industry product.</rdfs:comment>
        <rdfs:label xml:lang="fr">A pour attribut</rdfs:label>
        <rdfs:label xml:lang="en">Has attribute</rdfs:label>
        <skos:prefLabel xml:lang="fr">A pour attribut</skos:prefLabel>
        <skos:prefLabel xml:lang="en">Has attribute</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://natclinn.github.io/hasCalculatedNOVAgroupDetails -->


    <owl:ObjectProperty rdf:about="https://natclinn.github.io/hasCalculatedNOVAgroupDetails">
        <rdfs:domain rdf:resource="https://natclinn.github.io/Product"/>
        <rdfs:range rdf:resource="https://natclinn.github.io/CalculatedNOVAgroupDetails"/>
        <rdfs:comment xml:lang="en">Links a product to its calculated NOVA group details.</rdfs:comment>
        <rdfs:comment xml:lang="fr">Relie un produit aux détails de son groupe NOVA calculé.</rdfs:comment>
        <rdfs:label xml:lang="fr">A pour détails du groupe NOVA calculé</rdfs:label>
        <rdfs:label xml:lang="en">Has calculated NOVA group details</rdfs:label>
        <skos:prefLabel xml:lang="fr">A pour détails du groupe NOVA calculé</skos:prefLabel>
        <skos:prefLabel xml:lang="en">Has calculated NOVA group details</skos:prefLabel>
    </owl:ObjectProperty>
    


