        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://natclinn.github.io/Ingredient"/>
                    <rdf:Description rdf:about="https://natclinn.github.io/Product"/>
