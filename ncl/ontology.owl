        <rdfs:domain rdf:resource="https://natclinn.github.io/Product"/>
        <rdfs:range rdf:resource="https://natclinn.github.io/CleanLabel"/>
        <rdfs:comment xml:lang="en">Links a product to clean-label information.</rdfs:comment>
