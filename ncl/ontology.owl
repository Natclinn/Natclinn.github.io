    <!-- https://natclinn.github.io/target -->


    <owl:ObjectProperty rdf:about="https://natclinn.github.io/target">
        <rdfs:domain rdf:resource="https://natclinn.github.io/ProductArgument"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://natclinn.github.io/Allegation"/>
                    <rdf:Description rdf:about="https://natclinn.github.io/CleanLabel"/>
                    <rdf:Description rdf:about="https://natclinn.github.io/ControlledOriginLabel"/>
                    <rdf:Description rdf:about="https://natclinn.github.io/Ingredient"/>
                    <rdf:Description rdf:about="https://natclinn.github.io/ManufacturingProcess"/>
                    <rdf:Description rdf:about="https://natclinn.github.io/NutriScore"/>
                    <rdf:Description rdf:about="https://natclinn.github.io/Origin"/>
                    <rdf:Description rdf:about="https://natclinn.github.io/Packaging"/>
                    <rdf:Description rdf:about="https://natclinn.github.io/Product"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment xml:lang="en">Link an argument to a component (product, ingredient, packaging, nutri-score, etc.) of a food industry product.</rdfs:comment>
        <rdfs:comment xml:lang="fr">Relie un argument à un composant (produit, ingrédient, packaging, nutri-score,etc.) d&apos;un produit de l&apos;industrie agro-alimentaire.</rdfs:comment>
        <rdfs:label xml:lang="fr">Cible</rdfs:label>
        <rdfs:label xml:lang="en">Target</rdfs:label>
        <skos:prefLabel xml:lang="fr">Cible</skos:prefLabel>
        <skos:prefLabel xml:lang="en">Target</skos:prefLabel>
    </owl:ObjectProperty>
    


