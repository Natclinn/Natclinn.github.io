    <!-- https://natclinn.github.io/hasControlledOriginLabel -->


    <owl:ObjectProperty rdf:about="https://natclinn.github.io/hasControlledOriginLabel">
        <rdfs:domain rdf:resource="https://natclinn.github.io/Product"/>
