        <rdfs:domain rdf:resource="https://natclinn.github.io/ProductArgument"/>
        <rdfs:range rdf:resource="https://natclinn.github.io/Category"/>
        <rdfs:comment xml:lang="en">Links an argument to its main category.</rdfs:comment>
        <rdfs:comment xml:lang="fr">Relie un argument à sa catégorie principale.</rdfs:comment>
        <rdfs:label xml:lang="fr">A pour catégorie</rdfs:label>
        <rdfs:label xml:lang="en">Has category</rdfs:label>
        <skos:prefLabel xml:lang="fr">A pour catégorie</skos:prefLabel>
        <skos:prefLabel xml:lang="en">Has category</skos:prefLabel>
    </owl:ObjectProperty>
    


