        <skos:prefLabel xml:lang="en">Has controlled origin label</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://natclinn.github.io/hasFNI -->


    <owl:ObjectProperty rdf:about="https://natclinn.github.io/hasFNI">
        <rdfs:domain rdf:resource="https://natclinn.github.io/Product"/>
        <rdfs:range rdf:resource="https://natclinn.github.io/FNI"/>
        <rdfs:comment xml:lang="en">Links a product to its Food Naturalness Index resource.</rdfs:comment>
        <rdfs:comment xml:lang="fr">Relie un produit à sa ressource d&apos;indice de naturalité alimentaire.</rdfs:comment>
        <rdfs:label xml:lang="fr">A pour FNI</rdfs:label>
        <rdfs:label xml:lang="en">Has FNI</rdfs:label>
        <skos:prefLabel xml:lang="fr">A pour FNI</skos:prefLabel>
        <skos:prefLabel xml:lang="en">Has FNI</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://natclinn.github.io/hasIngredient -->


