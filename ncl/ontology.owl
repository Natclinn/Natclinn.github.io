        <rdfs:label xml:lang="fr">A pour contexte ingrédient</rdfs:label>
        <rdfs:label xml:lang="en">Has ingredient context</rdfs:label>
        <skos:prefLabel xml:lang="fr">A pour contexte ingrédient</skos:prefLabel>
        <skos:prefLabel xml:lang="en">Has ingredient context</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://natclinn.github.io/hasContextProduct -->


    <owl:ObjectProperty rdf:about="https://natclinn.github.io/hasContextProduct">
        <rdfs:domain rdf:resource="https://natclinn.github.io/Context"/>
        <rdfs:range rdf:resource="https://natclinn.github.io/ContextProduct"/>
