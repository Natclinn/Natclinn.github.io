<?xml version="1.0"?>
<rdf:RDF xmlns="https://natclinn.github.io/NatclinnTbox#"
     xml:base="https://natclinn.github.io/NatclinnTbox"
     xmlns:dc="http://purl.org/dc/elements/1.1/"
     xmlns:org="http://www.w3.org/ns/org#"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
