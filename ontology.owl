    <owl:disjointWith rdf:resource="https://w3id.org/NCL/ontology/NaturalnessScore"/>
    <owl:disjointWith>
      <owl:Class rdf:about="https://w3id.org/NCL/ontology/Origin"/>
    </owl:disjointWith>
    <rdfs:subClassOf rdf:resource="https://w3id.org/NCL/ontology/NCL"/>
    <owl:disjointWith rdf:resource="https://w3id.org/NCL/ontology/CalculatedNOVAgroupDetails"/>
    <rdfs:comment xml:lang="fr">La manière dont le produit est fabriqué.</rdfs:comment>
