    <rdfs:comment xml:lang="fr">Ingrédient utilisé comme additif (colorant, conservateur…).</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/NCL/ontology/UltraProcessedIngredient">
