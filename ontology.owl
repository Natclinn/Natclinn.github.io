    <rdfs:comment xml:lang="fr">Relie un produit à la fonction de ses ingrédients.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/NCL/ontology/aboutTag">
    <rdfs:range rdf:resource="https://w3id.org/NCL/ontology/Tag"/>
    <rdfs:domain rdf:resource="https://w3id.org/NCL/ontology/TagArgumentBinding"/>
