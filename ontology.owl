    <rdfs:comment xml:lang="fr">Ingrédient ayant subi une transformation (farine, huile…).</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/NCL/ontology/AdditiveIngredient">
    <rdfs:subClassOf rdf:resource="https://w3id.org/NCL/ontology/IngredientByFunction"/>
