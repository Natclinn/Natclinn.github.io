    <rdfs:comment xml:lang="fr">Relie un argument à sa sous-catégorie.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/NCL/ontology/target">
    <rdfs:range rdf:parseType="Resource">
      <owl:unionOf rdf:parseType="Collection">
        <owl:Class rdf:about="https://w3id.org/NCL/ontology/Ingredient"/>
        <owl:Class rdf:about="https://w3id.org/NCL/ontology/Product"/>
        <owl:Class rdf:about="https://w3id.org/NCL/ontology/Packaging"/>
        <owl:Class rdf:about="https://w3id.org/NCL/ontology/Allegation"/>
        <owl:Class rdf:about="https://w3id.org/NCL/ontology/CleanLabel"/>
        <owl:Class rdf:about="https://w3id.org/NCL/ontology/ManufacturingProcess"/>
        <owl:Class rdf:about="https://w3id.org/NCL/ontology/NutriScore"/>
        <owl:Class rdf:about="https://w3id.org/NCL/ontology/Origin"/>
        <owl:Class rdf:about="https://w3id.org/NCL/ontology/ControlledOriginLabel"/>
      </owl:unionOf>
    </rdfs:range>
    <rdfs:domain rdf:resource="https://w3id.org/NCL/ontology/ProductArgument"/>
    <rdfs:comment xml:lang="en">Link an argument to a component (product, ingredient, packaging, nutri-score, etc.) of a food industry product.</rdfs:comment>
    <rdfs:comment xml:lang="fr">Relie un argument à un composant (produit, ingrédient, packaging, nutri-score,etc.) d'un produit de l'industrie agro-alimentaire.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/NCL/ontology/hasRole">
    <rdfs:range rdf:resource="https://w3id.org/NCL/ontology/Tag"/>
    <rdfs:domain rdf:resource="https://w3id.org/NCL/ontology/Ingredient"/>
    <rdfs:comment xml:lang="en">Links an ingredient to a Tag resource representing its technological or sensory function (preservative, flavor enhancer, etc.).</rdfs:comment>
    <rdfs:comment xml:lang="fr">Relie un ingrédient à une ressource Tag représentant sa fonction technologique ou sensorielle (conservateur, exhausteur de goût, etc.).</rdfs:comment>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/NCL/ontology/hasTagInitiator">
    <rdfs:range rdf:resource="https://w3id.org/NCL/ontology/Tag"/>
    <rdfs:domain rdf:resource="https://w3id.org/NCL/ontology/LinkToArgument"/>
    <rdfs:comment xml:lang="en">Tag identifying who initiated the link to the argument.</rdfs:comment>
    <rdfs:comment xml:lang="fr">Tag identifiant qui a initié le lien vers l'argument.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/NCL/ontology/hasFNI">
    <rdfs:range rdf:resource="https://w3id.org/NCL/ontology/FNI"/>
    <rdfs:domain rdf:resource="https://w3id.org/NCL/ontology/Product"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/NCL/ontology/hasTypeSource">
    <rdfs:range rdf:resource="https://w3id.org/NCL/ontology/TypeSource"/>
    <rdfs:domain rdf:resource="https://w3id.org/NCL/ontology/Source"/>
    <rdfs:comment xml:lang="en">Link a source to its type (expert, peer-reviewed article, etc.).</rdfs:comment>
    <rdfs:comment xml:lang="fr">Relie une source à son type (expert, article peer-reviewed, etc.).</rdfs:comment>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/NCL/ontology/hasReferenceProductArgument">
    <rdfs:range rdf:resource="https://w3id.org/NCL/ontology/ProductArgument"/>
    <rdfs:domain rdf:resource="https://w3id.org/NCL/ontology/LinkToArgument"/>
    <rdfs:comment xml:lang="en">Links a LinkToArgument to the referenced ProductArgument.</rdfs:comment>
    <rdfs:comment xml:lang="fr">Relie un LinkToArgument au ProductArgument référencé.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/NCL/ontology/hasCategory">
    <rdfs:range rdf:resource="https://w3id.org/NCL/ontology/Category"/>
    <rdfs:domain rdf:resource="https://w3id.org/NCL/ontology/ProductArgument"/>
    <rdfs:comment xml:lang="en">Links an argument to its main category.</rdfs:comment>
    <rdfs:comment xml:lang="fr">Relie un argument à sa catégorie principale.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/NCL/ontology/hasContextIngredient">
    <rdfs:range rdf:resource="https://w3id.org/NCL/ontology/ContextIngredient"/>
    <rdfs:domain rdf:resource="https://w3id.org/NCL/ontology/Context"/>
    <rdfs:comment xml:lang="en">The ingredient context of an argument.</rdfs:comment>
    <rdfs:comment xml:lang="fr">Le contexte ingrédient d'un argument.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/NCL/ontology/hasPackaging">
    <rdfs:range rdf:resource="https://w3id.org/NCL/ontology/Packaging"/>
    <rdfs:domain rdf:resource="https://w3id.org/NCL/ontology/Product"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/NCL/ontology/hasComposedOf">
    <rdfs:range rdf:parseType="Resource">
      <owl:unionOf rdf:parseType="Collection">
        <owl:Class rdf:about="https://w3id.org/NCL/ontology/Ingredient"/>
        <owl:Class rdf:about="https://w3id.org/NCL/ontology/Product"/>
