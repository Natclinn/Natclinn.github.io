    <rdfs:comment xml:lang="fr">Relie un produit aux détails de sa classification NOVA.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/NCL/ontology/hasSubcategory">
