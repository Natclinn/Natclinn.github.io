    <rdfs:comment xml:lang="fr">Relie un TagArgumentBinding au Tag concerné.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/NCL/ontology/hasNaturalnessScore">
    <rdfs:range rdf:resource="https://w3id.org/NCL/ontology/NaturalnessScore"/>
    <rdfs:domain rdf:resource="https://w3id.org/NCL/ontology/Product"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/NCL/ontology/identifier">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:domain rdf:resource="https://w3id.org/NCL/ontology/Resource"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/NCL/ontology/hasProcessedIngredients">
    <rdfs:range rdf:resource="https://w3id.org/NCL/ontology/Ingredient"/>
    <rdfs:domain rdf:resource="https://w3id.org/NCL/ontology/CalculatedNOVAgroupDetails"/>
    <rdfs:comment xml:lang="en">Lists processed ingredients found during NOVA calculation.</rdfs:comment>
    <rdfs:comment xml:lang="fr">Liste les ingrédients transformés trouvés lors du calcul NOVA.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/NCL/ontology/hasStakeholder">
    <rdfs:range rdf:resource="https://w3id.org/NCL/ontology/Stakeholder"/>
    <rdfs:domain rdf:resource="https://w3id.org/NCL/ontology/ProductArgument"/>
    <rdfs:comment xml:lang="en">Link an argument to its stakeholder (consumer, manufacturer, etc.).</rdfs:comment>
    <rdfs:comment xml:lang="fr">Relie un argument à sa partie prenante (consommateur, fabricant, etc.).</rdfs:comment>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/NCL/ontology/hasIngredient">
    <rdfs:range rdf:resource="https://w3id.org/NCL/ontology/Ingredient"/>
    <rdfs:domain rdf:resource="https://w3id.org/NCL/ontology/Product"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/NCL/ontology/hasNutriScore">
    <rdfs:range rdf:resource="https://w3id.org/NCL/ontology/NutriScore"/>
    <rdfs:domain rdf:resource="https://w3id.org/NCL/ontology/Product"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/NCL/ontology/hasShape">
    <rdfs:range rdf:resource="https://w3id.org/NCL/ontology/Shape"/>
    <rdfs:domain rdf:resource="https://w3id.org/NCL/ontology/Packaging"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/NCL/ontology/hasRawIngredients">
    <rdfs:range rdf:resource="https://w3id.org/NCL/ontology/Ingredient"/>
    <rdfs:domain rdf:resource="https://w3id.org/NCL/ontology/CalculatedNOVAgroupDetails"/>
    <rdfs:comment xml:lang="en">Lists raw ingredients found during NOVA calculation.</rdfs:comment>
    <rdfs:comment xml:lang="fr">Liste les ingrédients bruts trouvés lors du calcul NOVA.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/NCL/ontology/hasOrigin">
    <rdfs:range rdf:resource="https://w3id.org/NCL/ontology/Origin"/>
    <rdfs:domain rdf:resource="https://w3id.org/NCL/ontology/Ingredient"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/NCL/ontology/fiability">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
    <rdfs:domain rdf:resource="https://w3id.org/NCL/ontology/TypeSource"/>
    <rdfs:comment xml:lang="en">Fiability score of the source type.</rdfs:comment>
    <rdfs:comment xml:lang="fr">Score de fiabilité du type de source.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/NCL/ontology/hasText">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:domain rdf:resource="https://w3id.org/NCL/ontology/Verbatim"/>
    <rdfs:comment xml:lang="en">Verbatim text.</rdfs:comment>
    <rdfs:comment xml:lang="fr">Texte du verbatim.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/NCL/ontology/aim">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:domain rdf:resource="https://w3id.org/NCL/ontology/TagArgumentBinding"/>
    <rdfs:comment xml:lang="en">Aim or objective related to the tag binding.</rdfs:comment>
    <rdfs:comment xml:lang="fr">Objectif ou visée du binding de tag.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/NCL/ontology/condition">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:domain rdf:resource="https://w3id.org/NCL/ontology/ProductArgument"/>
    <rdfs:comment xml:lang="en">Condition under which the argument applies.</rdfs:comment>
    <rdfs:comment xml:lang="fr">Condition dans laquelle l'argument s'applique.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/NCL/ontology/supportType">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:domain rdf:resource="https://w3id.org/NCL/ontology/ProductArgument"/>
    <rdfs:comment xml:lang="en">Type of argument (positive or negative) in relation to its target.</rdfs:comment>
    <rdfs:comment xml:lang="fr">Type de l'argument (positif ou négatif) vis à vis de sa cible.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/NCL/ontology/hasCiqualFoodCode">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:domain rdf:resource="https://w3id.org/NCL/ontology/Ingredient"/>
    <rdfs:comment xml:lang="en">Ciqual code for a food industry product.</rdfs:comment>
    <rdfs:comment xml:lang="fr">Code Ciqual d'un produit de l'industrie agroalimentaire.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/NCL/ontology/assertion">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:domain rdf:resource="https://w3id.org/NCL/ontology/TagArgumentBinding"/>
    <rdfs:comment xml:lang="en">The assertion carried by the tag binding.</rdfs:comment>
    <rdfs:comment xml:lang="fr">L'assertion portée par le binding de tag.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/NCL/ontology/rank">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#nonNegativeInteger"/>
    <rdfs:domain rdf:resource="https://w3id.org/NCL/ontology/QuantifiedElement"/>
    <rdfs:comment xml:lang="en">Classification of an ingredient or by-product in the textual statement of a product's composition.</rdfs:comment>
    <rdfs:comment xml:lang="fr">Classement d'un ingrédient ou d'un sous-produit dans l’énoncé textuel de la composition d'un produit.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/NCL/ontology/nameProperty">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:domain rdf:resource="https://w3id.org/NCL/ontology/TagArgumentBinding"/>
    <rdfs:comment xml:lang="en">Name of the property evaluated in the tag binding.</rdfs:comment>
    <rdfs:comment xml:lang="fr">Nom de la propriété évaluée dans le binding de tag.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/NCL/ontology/groupe2">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:domain rdf:resource="https://w3id.org/NCL/ontology/NOVAgroupDetails"/>
    <rdfs:comment xml:lang="en">NOVA group 2 characteristics (processed culinary ingredients).</rdfs:comment>
    <rdfs:comment xml:lang="fr">Caractéristiques du groupe NOVA 2 (ingrédients culinaires transformés).</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/NCL/ontology/groupe1">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:domain rdf:resource="https://w3id.org/NCL/ontology/NOVAgroupDetails"/>
    <rdfs:comment xml:lang="en">NOVA group 1 characteristics (unprocessed or minimally processed foods).</rdfs:comment>
    <rdfs:comment xml:lang="fr">Caractéristiques du groupe NOVA 1 (aliments non transformés ou minimalement transformés).</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/NCL/ontology/groupe4">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:domain rdf:resource="https://w3id.org/NCL/ontology/NOVAgroupDetails"/>
    <rdfs:comment xml:lang="en">NOVA group 4 characteristics (ultra-processed foods and drinks).</rdfs:comment>
    <rdfs:comment xml:lang="fr">Caractéristiques du groupe NOVA 4 (produits ultra-transformés).</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/NCL/ontology/groupe3">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:domain rdf:resource="https://w3id.org/NCL/ontology/NOVAgroupDetails"/>
    <rdfs:comment xml:lang="en">NOVA group 3 characteristics (processed foods).</rdfs:comment>
    <rdfs:comment xml:lang="fr">Caractéristiques du groupe NOVA 3 (aliments transformés).</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/NCL/ontology/hasCiqualProxyFoodCode">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:domain rdf:resource="https://w3id.org/NCL/ontology/Ingredient"/>
    <rdfs:comment xml:lang="en">Ciqual code for a similar food industry product.</rdfs:comment>
    <rdfs:comment xml:lang="fr">Code Ciqual d'un produit similaire de l'industrie agroalimentaire.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/NCL/ontology/valueProperty">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:domain rdf:resource="https://w3id.org/NCL/ontology/TagArgumentBinding"/>
    <rdfs:comment xml:lang="en">Value associated with the tag binding property.</rdfs:comment>
    <rdfs:comment xml:lang="fr">Valeur associée à la propriété du binding de tag.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/NCL/ontology/percentage">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
    <rdfs:domain rdf:resource="https://w3id.org/NCL/ontology/QuantifiedElement"/>
    <rdfs:comment xml:lang="en">Percentage (by weight) of a by-product or ingredient in a food industry product.</rdfs:comment>
    <rdfs:comment xml:lang="fr">Pourcentage (du poids) d'un sous-produit ou d'un ingrédient dans un produit de l'industrie agro-alimentaire.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/NCL/ontology/hasNOVAgroup">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#nonNegativeInteger"/>
    <rdfs:domain rdf:resource="https://w3id.org/NCL/ontology/Product"/>
    <rdfs:comment xml:lang="en">NOVA group (1..4) as provided by Open Food Facts.</rdfs:comment>
    <rdfs:comment xml:lang="fr">Groupe NOVA (1..4) tel que fourni par Open Food Facts.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/NCL/ontology/quantity">
    <rdfs:domain rdf:resource="https://w3id.org/NCL/ontology/QuantifiedElement"/>
    <rdfs:comment xml:lang="en">Quantity of a by-product or ingredient present in a food industry product.</rdfs:comment>
    <rdfs:comment xml:lang="fr">Quantité présente d'un sous-produit ou d'un ingrédient dans un produit de l'industrie agro-alimentaire.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/NCL/ontology/unitArg">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:domain rdf:resource="https://w3id.org/NCL/ontology/ProductArgument"/>
    <rdfs:comment xml:lang="en">Unit of measurement for the argument values.</rdfs:comment>
    <rdfs:comment xml:lang="fr">Unité de mesure pour les valeurs de l'argument.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/NCL/ontology/supValue">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
    <rdfs:domain rdf:resource="https://w3id.org/NCL/ontology/ProductArgument"/>
    <rdfs:comment xml:lang="en">Upper bound value for the argument condition.</rdfs:comment>
    <rdfs:comment xml:lang="fr">Valeur maximale pour la condition de l'argument.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/NCL/ontology/containsAdditives">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdfs:domain rdf:resource="https://w3id.org/NCL/ontology/Product"/>
    <rdfs:comment xml:lang="en">Indicates whether the product contains additives.</rdfs:comment>
    <rdfs:comment xml:lang="fr">Indique si le produit contient des additifs.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/NCL/ontology/unit">
    <rdfs:domain rdf:resource="https://w3id.org/NCL/ontology/QuantifiedElement"/>
    <rdfs:comment xml:lang="en">Unit of the quantity of a by-product or ingredient present in a food industry product.</rdfs:comment>
    <rdfs:comment xml:lang="fr">Unité de la quantité présente d'un sous-produit ou d'un ingrédient dans un produit de l'industrie agro-alimentaire.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/NCL/ontology/bindingKeywords">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:domain rdf:resource="https://w3id.org/NCL/ontology/TagArgumentBinding"/>
    <rdfs:comment xml:lang="en">Keywords used to bind a tag to argumentation context.</rdfs:comment>
    <rdfs:comment xml:lang="fr">Mots-clés utilisés pour lier un tag au contexte d'argumentation.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/NCL/ontology/nameCriterion">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:domain rdf:resource="https://w3id.org/NCL/ontology/TagArgumentBinding"/>
    <rdfs:comment xml:lang="en">Name of the criterion addressed by the tag binding.</rdfs:comment>
    <rdfs:comment xml:lang="fr">Nom du critère abordé par le binding de tag.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/NCL/ontology/infValue">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
    <rdfs:domain rdf:resource="https://w3id.org/NCL/ontology/ProductArgument"/>
    <rdfs:comment xml:lang="en">Lower bound value for the argument condition.</rdfs:comment>
    <rdfs:comment xml:lang="fr">Valeur minimale pour la condition de l'argument.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/NCL/ontology/hasCalculatedNOVAgroup">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#nonNegativeInteger"/>
    <rdfs:domain rdf:resource="https://w3id.org/NCL/ontology/Product"/>
    <rdfs:comment xml:lang="en">Calculated NOVA group (1..4) inferred by rules, not the OFF-provided value.</rdfs:comment>
    <rdfs:comment xml:lang="fr">Groupe NOVA calculé (1..4) inféré par les règles, distinct de la valeur fournie par OFF.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/NCL/ontology/polarity">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:domain rdf:resource="https://w3id.org/NCL/ontology/TagArgumentBinding"/>
    <rdfs:comment xml:lang="en">Polarity of the tag binding (positive '+' or negative '-').</rdfs:comment>
    <rdfs:comment xml:lang="fr">Polarité du binding de tag (positif '+' ou négatif '-').</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:AnnotationProperty rdf:about="http://www.w3.org/2000/01/rdf-schema#comment"/>
  <owl:AnnotationProperty rdf:about="https://w3id.org/NCL/ontology/hasIdIngredientOFF"/>
  <owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#prefLabel"/>
  <owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#definition"/>
  <owl:AnnotationProperty rdf:about="https://w3id.org/NCL/ontology/hasTrademark"/>
  <owl:AnnotationProperty rdf:about="http://www.w3.org/2000/01/rdf-schema#label"/>
  <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/created"/>
  <owl:AnnotationProperty rdf:about="https://w3id.org/NCL/ontology/hasEAN13"/>
  <owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#altLabel"/>
