    <owl:disjointWith rdf:resource="https://w3id.org/NCL/ontology/LinkToArgument"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/NCL/ontology/NCL"/>
    <owl:disjointWith rdf:resource="https://w3id.org/NCL/ontology/Source"/>
    <rdfs:comment xml:lang="fr">L'emballage d'un produit.</rdfs:comment>
    <owl:disjointWith rdf:resource="https://w3id.org/NCL/ontology/Origin"/>
    <rdfs:comment xml:lang="en">The packaging of a product.</rdfs:comment>
    <owl:disjointWith rdf:resource="https://w3id.org/NCL/ontology/Product"/>
    <rdfs:comment xml:lang="fr">Déclaration relative à des faits sur un produit dont l'existence reste à prouver.</rdfs:comment>
    <owl:disjointWith rdf:resource="https://w3id.org/NCL/ontology/TypeSource"/>
