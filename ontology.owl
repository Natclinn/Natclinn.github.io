  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://natclinn.github.io/hasCalculatedNOVAgroup">
    <skos:prefLabel xml:lang="en">Has calculated NOVA group</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">A pour groupe NOVA calculé</skos:prefLabel>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#nonNegativeInteger"/>
