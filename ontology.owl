    <owl:disjointWith rdf:resource="https://w3id.org/NCL/ontology/Stakeholder"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/NCL/ontology/ProcessedIngredient">
    <rdfs:subClassOf>
      <owl:Class rdf:about="https://w3id.org/NCL/ontology/IngredientByTransformationDegree"/>
    </rdfs:subClassOf>
