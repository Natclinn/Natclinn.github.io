        <owl:Class rdf:about="https://w3id.org/NCL/ontology/CompositeProduct"/>
      </owl:unionOf>
    </rdfs:domain>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/NCL/ontology/hasSource">
    <rdfs:range rdf:resource="https://w3id.org/NCL/ontology/Source"/>
    <rdfs:domain rdf:resource="https://w3id.org/NCL/ontology/ProductArgument"/>
    <rdfs:comment xml:lang="en">Link an argument to its source (consumer survey, scientific journal, etc.).</rdfs:comment>
    <rdfs:comment xml:lang="fr">Relie un argument à sa source (enquête consommateur, revue scientifique, etc.).</rdfs:comment>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/NCL/ontology/hasAttribute">
    <rdfs:range rdf:resource="https://w3id.org/NCL/ontology/Attribute"/>
    <rdfs:domain rdf:resource="https://w3id.org/NCL/ontology/ProductArgument"/>
    <rdfs:comment xml:lang="en">The naturalness attribute of a food industry product.</rdfs:comment>
    <rdfs:comment xml:lang="fr">Attribut de la naturalité d'un produit de l'industrie agro-alimentaire.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/NCL/ontology/hasContext">
    <rdfs:range rdf:resource="https://w3id.org/NCL/ontology/Context"/>
    <rdfs:domain rdf:resource="https://w3id.org/NCL/ontology/ProductArgument"/>
    <rdfs:comment xml:lang="en">Links an argument to its context</rdfs:comment>
    <rdfs:comment xml:lang="fr">Relie un argument à son contexte</rdfs:comment>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/NCL/ontology/refersTo">
    <rdfs:range rdf:parseType="Resource">
      <owl:unionOf rdf:parseType="Collection">
        <owl:Class rdf:about="https://w3id.org/NCL/ontology/Ingredient"/>
        <owl:Class rdf:about="https://w3id.org/NCL/ontology/Product"/>
      </owl:unionOf>
    </rdfs:range>
    <rdfs:domain rdf:resource="https://w3id.org/NCL/ontology/QuantifiedElement"/>
    <rdfs:comment xml:lang="en">Relates a product or ingredient to its quantification in a food industry product.</rdfs:comment>
    <rdfs:comment xml:lang="fr">Relie un produit ou un ingrédient à sa quantification dans un produit de l'industrie agro-alimentaire.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/NCL/ontology/hasCalculatedNOVAgroupDetails">
    <rdfs:range rdf:resource="https://w3id.org/NCL/ontology/CalculatedNOVAgroupDetails"/>
    <rdfs:domain rdf:resource="https://w3id.org/NCL/ontology/Product"/>
    <rdfs:comment xml:lang="en">Links a product to its calculated NOVA group details.</rdfs:comment>
    <rdfs:comment xml:lang="fr">Relie un produit aux détails de son groupe NOVA calculé.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/NCL/ontology/hasLinkToArgument">
    <rdfs:range rdf:resource="https://w3id.org/NCL/ontology/LinkToArgument"/>
    <rdfs:domain rdf:resource="https://w3id.org/NCL/ontology/Product"/>
    <rdfs:comment xml:lang="en">Links a food industry product to a LinkToArgument that connects to a ProductArgument.</rdfs:comment>
    <rdfs:comment xml:lang="fr">Relie un produit de l'industrie agro-alimentaire à un LinkToArgument qui se connecte à un ProductArgument.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/NCL/ontology/hasContextProduct">
    <rdfs:range rdf:resource="https://w3id.org/NCL/ontology/ContextProduct"/>
    <rdfs:domain rdf:resource="https://w3id.org/NCL/ontology/Context"/>
    <rdfs:comment xml:lang="en">The product context of an argument.</rdfs:comment>
    <rdfs:comment xml:lang="fr">Le contexte produit d'un argument.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/NCL/ontology/hasProductArgument">
    <rdfs:range rdf:resource="https://w3id.org/NCL/ontology/ProductArgument"/>
    <rdfs:domain rdf:resource="https://w3id.org/NCL/ontology/Product"/>
    <rdfs:comment xml:lang="en">Link a food industry product to an argument.</rdfs:comment>
    <rdfs:comment xml:lang="fr">Relie un produit de l'industrie agro-alimentaire à un argument.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/NCL/ontology/hasTagArgumentBindingInitiator">
    <rdfs:range rdf:resource="https://w3id.org/NCL/ontology/TagArgumentBinding"/>
    <rdfs:domain rdf:resource="https://w3id.org/NCL/ontology/LinkToArgument"/>
