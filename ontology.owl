    <skos:prefLabel xml:lang="en">Refers to</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Réfère à</skos:prefLabel>
    <rdfs:range rdf:parseType="Resource">
      <owl:unionOf rdf:parseType="Collection">
        <owl:Class rdf:about="https://natclinn.github.io/Ingredient"/>
        <owl:Class rdf:about="https://natclinn.github.io/Product"/>
      </owl:unionOf>
    </rdfs:range>
    <rdfs:label xml:lang="en">Refers to</rdfs:label>
    <rdfs:label xml:lang="fr">Réfère à</rdfs:label>
    <rdfs:domain rdf:resource="https://natclinn.github.io/QuantifiedElement"/>
    <rdfs:comment xml:lang="en">Relates a product or ingredient to its quantification in a food industry product.</rdfs:comment>
    <rdfs:comment xml:lang="fr">Relie un produit ou un ingrédient à sa quantification dans un produit de l'industrie agro-alimentaire.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://natclinn.github.io/hasTypeSource">
