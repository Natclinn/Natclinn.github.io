    <rdfs:label xml:lang="fr">A pour lien vers argument</rdfs:label>
    <rdfs:domain rdf:resource="https://natclinn.github.io/Product"/>
    <rdfs:comment xml:lang="en">Links a food industry product to a LinkToArgument that connects to a ProductArgument.</rdfs:comment>
    <rdfs:comment xml:lang="fr">Relie un produit de l'industrie agro-alimentaire à un LinkToArgument qui se connecte à un ProductArgument.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://natclinn.github.io/hasContextProduct">
    <skos:prefLabel xml:lang="en">Has product context</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">A pour contexte produit</skos:prefLabel>
    <rdfs:range rdf:resource="https://natclinn.github.io/ContextProduct"/>
