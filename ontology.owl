    <rdfs:domain rdf:resource="https://natclinn.github.io/TagArgumentBinding"/>
    <rdfs:comment xml:lang="en">Name of the criterion addressed by the tag binding.</rdfs:comment>
    <rdfs:comment xml:lang="fr">Nom du critère abordé par le binding de tag.</rdfs:comment>
  </owl:DatatypeProperty>
