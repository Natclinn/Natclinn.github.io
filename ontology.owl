          </foaf:Organization>
        </org:memberOf>
        <schema:url rdf:resource="https://orcid.org/0000-0001-9418-5330"/>
        <schema:name xml:lang="fr">Pierre Bisquert</schema:name>
        <schema:name xml:lang="en">Pierre Bisquert</schema:name>
      </schema:Person>
    </schema:creator>
