  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/NCL/ontology/SyntheticOrBiotechIngredient">
    <rdfs:subClassOf rdf:resource="https://w3id.org/NCL/ontology/IngredientByOrigin"/>
