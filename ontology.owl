    <owl:disjointWith rdf:resource="https://w3id.org/NCL/ontology/Stakeholder"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/NCL/ontology/Packaging">
    <owl:disjointWith rdf:resource="https://w3id.org/NCL/ontology/Material"/>
