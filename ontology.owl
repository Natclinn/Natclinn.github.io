    <rdfs:comment xml:lang="fr">Relie un produit à ses allégations.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://natclinn.github.io/hasLinkToArgument">
    <skos:prefLabel xml:lang="en">Has link to argument</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">A pour lien vers argument</skos:prefLabel>
    <rdfs:range rdf:resource="https://natclinn.github.io/LinkToArgument"/>
